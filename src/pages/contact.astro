---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "যোগাযোগ করুন";
const description = "ByteForge Vlog-এর সাথে যোগাযোগ করুন। আমরা আপনার মতামত এবং প্রশ্নের অপেক্ষায় আছি।";
---

<BaseLayout title={title} description={description}>
  <article class="contact-page">
    <h1>যোগাযোগ করুন</h1>
    <p class="subtitle">আপনার মতামত, প্রশ্ন বা পরামর্শ আমাদের জানান</p>

    <div class="contact-grid">
      <div class="contact-info">
        <h2>যোগাযোগের তথ্য</h2>
        <div class="info-item">
          <span class="info-icon">📧</span>
          <div>
            <strong>ইমেইল</strong>
            <p>contact@byteforgevlog.com</p>
          </div>
        </div>
        <div class="info-item">
          <span class="info-icon">📍</span>
          <div>
            <strong>অবস্থান</strong>
            <p>বাংলাদেশ</p>
          </div>
        </div>
        <div class="info-item">
          <span class="info-icon">⏰</span>
          <div>
            <strong>সাড়া দেওয়ার সময়</strong>
            <p>সাধারণত ২৪-৪৮ ঘণ্টার মধ্যে</p>
          </div>
        </div>

        <div class="social-links">
          <h3>সোশ্যাল মিডিয়া</h3>
          <a href="#" class="social-btn">YouTube</a>
          <a href="#" class="social-btn">Facebook</a>
          <a href="#" class="social-btn">Twitter/X</a>
        </div>
      </div>

      <div class="contact-form-wrapper">
        <h2>মেসেজ পাঠান</h2>
        <!-- 
          NOTE: Astro static sites এ form কাজ করানোর জন্য
          Netlify Forms, Formspree, বা EmailJS ব্যবহার করুন।
          নিচে Formspree উদাহরণ দেওয়া হয়েছে।
        -->
        <form
          action="https://formspree.io/f/YOUR_FORM_ID"
          method="POST"
          class="contact-form"
        >
          <div class="form-group">
            <label for="name">আপনার নাম *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="আপনার পূর্ণ নাম"
            />
          </div>

          <div class="form-group">
            <label for="email">ইমেইল ঠিকানা *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
            />
          </div>

          <div class="form-group">
            <label for="subject">বিষয়</label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="মেসেজের বিষয়"
            />
          </div>

          <div class="form-group">
            <label for="message">আপনার বার্তা *</label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              placeholder="আপনার বার্তা লিখুন..."
            ></textarea>
          </div>

          <button type="submit" class="submit-btn">
            পাঠান ✉️
          </button>
        </form>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .contact-page {
    max-width: 900px;
    margin: 0 auto;
  }

  h1 {
    font-size: 2.2rem;
    color: #1a1a2e;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #666;
    margin-bottom: 2.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
  }

  h2 {
    font-size: 1.3rem;
    color: #1a1a2e;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #00d4ff;
  }

  .info-item {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    align-items: flex-start;
  }

  .info-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .info-item strong {
    display: block;
    font-size: 0.9rem;
    color: #1a1a2e;
    margin-bottom: 2px;
  }

  .info-item p {
    color: #666;
    margin: 0;
    font-size: 0.9rem;
  }

  .social-links {
    margin-top: 2rem;
  }

  .social-links h3 {
    font-size: 1rem;
    color: #1a1a2e;
    margin-bottom: 0.8rem;
  }

  .social-btn {
    display: inline-block;
    background: #f0f0f0;
    color: #333;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    text-decoration: none;
    font-size: 0.85rem;
    margin: 0.3rem 0.3rem 0 0;
    transition: background 0.2s, color 0.2s;
  }

  .social-btn:hover {
    background: #1a1a2e;
    color: white;
  }

  .form-group {
    margin-bottom: 1.2rem;
  }

  label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: #333;
    margin-bottom: 0.4rem;
  }

  input, textarea {
    width: 100%;
    padding: 0.7rem 1rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
    color: #333;
    background: #fafafa;
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: #00d4ff;
    box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.15);
    background: white;
  }

  textarea {
    resize: vertical;
  }

  .submit-btn {
    background: #1a1a2e;
    color: white;
    border: none;
    padding: 0.8rem 2rem;
    border-radius: 6px;
    font-size: 1rem;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s, transform 0.1s;
    width: 100%;
  }

  .submit-btn:hover {
    background: #00d4ff;
    color: #1a1a2e;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
