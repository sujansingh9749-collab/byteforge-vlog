---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<BaseLayout title="ByteForge - অল ব্লগ পোস্ট">
  <div class="mb-10">
    <h1 class="text-3xl font-black text-white mb-2 tracking-tight">আমাদের সব ব্লগ ও ভ্লগ</h1>
    <p class="text-slate-400 text-sm">টেকনিক্যাল টিউটোরিয়াল ও অটোমেশন গাইড</p>
  </div>

  <div class="grid gap-6">
    {posts.map((post) => (
      <a href={`/blog/${post.id}`} class="block p-6 rounded-2xl bg-slate-950/50 border border-slate-900 hover:border-blue-500/50 transition shadow-sm group">
        <h2 class="text-xl font-bold text-white group-hover:text-blue-400 transition mb-2">{post.data.title}</h2>
        <p class="text-slate-400 text-sm mb-3">{post.data.description}</p>
        <div class="text-xs text-slate-500">
          {new Date(post.data.pubDate).toLocaleDateString('bn-BD')}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
