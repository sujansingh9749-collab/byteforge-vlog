---
// src/layouts/BlogPostLayout.astro
// AdSense-ready Blog Post Layout - বিজ্ঞাপনের সঠিক জায়গা সহ

import BaseLayout from './BaseLayout.astro';
import AdUnit from '../components/AdUnit.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author?: string;
  category?: string;
  image?: string;
  tags?: string[];
}

const {
  title,
  description,
  pubDate,
  author = "ByteForge Team",
  category = "Technology",
  image,
  tags = [],
} = Astro.props;

// Schema.org Article structured data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": pubDate.toISOString(),
  "dateModified": pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "ByteForge Vlog",
    "url": "https://byteforgevlog.com"
  },
  ...(image && { "image": image })
};
---

<BaseLayout title={title} description={description} image={image}>
  <!-- Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="blog-wrapper">
    <!-- Main Content Column -->
    <article class="blog-post">
      <!-- Post Header -->
      <header class="post-header">
        {category && (
          <span class="category-badge">{category}</span>
        )}
        <h1>{title}</h1>
        <div class="post-meta">
          <span>✍️ {author}</span>
          <span>📅 {pubDate.toLocaleDateString('bn-BD', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
        {tags.length > 0 && (
          <div class="tags">
            {tags.map(tag => (
              <a href={`/tag/${tag}`} class="tag">#{tag}</a>
            ))}
          </div>
        )}
      </header>

      <!-- ✅ Ad Unit 1: Post-Header (728x90 Leaderboard) -->
      <AdUnit
        slot="1111111111"
        format="horizontal"
        label={true}
      />

      <!-- Hero Image -->
      {image && (
        <img
          src={image}
          alt={title}
          class="hero-image"
          width="800"
          height="450"
          loading="eager"
        />
      )}

      <!-- Post Content -->
      <div class="post-content">
        <slot />
      </div>

      <!-- ✅ Ad Unit 2: Mid-Content (336x280 Rectangle) -->
      <!-- এই component টি পোস্টের মাঝামাঝি MDX-এ ব্যবহার করুন -->

      <!-- ✅ Ad Unit 3: Post Footer (728x90) -->
      <AdUnit
        slot="2222222222"
        format="horizontal"
        label={true}
      />

      <!-- Post Footer -->
      <footer class="post-footer">
        <div class="share-section">
          <h3>এই পোস্টটি শেয়ার করুন:</h3>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${Astro.url}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn facebook"
          >
            Facebook-এ শেয়ার করুন
          </a>
          <a
            href={`https://twitter.com/intent/tweet?url=${Astro.url}&text=${encodeURIComponent(title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn twitter"
          >
            Twitter-এ শেয়ার করুন
          </a>
        </div>

        <nav class="post-nav" aria-label="পোস্ট নেভিগেশন">
          <a href="/blog" class="back-to-blog">← সব পোস্ট দেখুন</a>
        </nav>
      </footer>
    </article>

    <!-- Sidebar -->
    <aside class="sidebar">
      <!-- ✅ Sidebar Ad (300x250 Rectangle) -->
      <div class="sticky-sidebar">
        <AdUnit
          slot="3333333333"
          format="rectangle"
          fullWidth={false}
          label={true}
        />

        <!-- About Widget -->
        <div class="widget">
          <h3>সম্পর্কে</h3>
          <p>ByteForge Vlog - বাংলায় প্রযুক্তির সহজ গাইড।</p>
          <a href="/about" class="widget-link">আরও জানুন →</a>
        </div>

        <!-- Categories Widget -->
        <div class="widget">
          <h3>বিভাগ</h3>
          <ul class="category-list">
            <li><a href="/category/programming">Programming</a></li>
            <li><a href="/category/web-dev">Web Development</a></li>
            <li><a href="/category/tech-tips">Tech Tips</a></li>
            <li><a href="/category/reviews">Reviews</a></li>
          </ul>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .blog-wrapper {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }

  /* ===== ARTICLE ===== */
  .post-header {
    margin-bottom: 1.5rem;
  }

  .category-badge {
    background: #00d4ff;
    color: #1a1a2e;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: inline-block;
    margin-bottom: 0.8rem;
  }

  h1 {
    font-size: 2rem;
    color: #1a1a2e;
    line-height: 1.3;
    margin-bottom: 0.8rem;
  }

  .post-meta {
    display: flex;
    gap: 1.5rem;
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .tag {
    background: #f0f0f0;
    color: #555;
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .tag:hover {
    background: #1a1a2e;
    color: white;
  }

  .hero-image {
    width: 100%;
    height: auto;
    border-radius: 10px;
    margin: 1.5rem 0;
    object-fit: cover;
  }

  .post-content {
    font-size: 1.05rem;
    line-height: 1.85;
    color: #333;
  }

  .post-content :global(h2) {
    font-size: 1.5rem;
    color: #1a1a2e;
    margin: 2rem 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid #f0f0f0;
  }

  .post-content :global(h3) {
    font-size: 1.2rem;
    color: #1a1a2e;
    margin: 1.5rem 0 0.8rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.2rem;
  }

  .post-content :global(code) {
    background: #f4f4f4;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
    color: #d63031;
  }

  .post-content :global(pre) {
    background: #1a1a2e;
    color: #f8f8f2;
    padding: 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .post-content :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
  }

  .post-content :global(a) {
    color: #0066cc;
    text-decoration: underline;
  }

  .post-content :global(img) {
    max-width: 100%;
    border-radius: 8px;
    margin: 1rem 0;
  }

  .post-content :global(ul), .post-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid #00d4ff;
    padding: 0.5rem 1.5rem;
    margin: 1.5rem 0;
    background: #f8fbff;
    border-radius: 0 8px 8px 0;
    color: #555;
    font-style: italic;
  }

  /* Share buttons */
  .post-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid #eee;
  }

  .share-section h3 {
    font-size: 1rem;
    margin-bottom: 0.8rem;
    color: #555;
  }

  .share-btn {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    border-radius: 5px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    margin-right: 0.8rem;
    margin-bottom: 0.5rem;
    transition: opacity 0.2s;
  }

  .share-btn:hover {
    opacity: 0.85;
  }

  .facebook {
    background: #1877f2;
    color: white;
  }

  .twitter {
    background: #000;
    color: white;
  }

  .back-to-blog {
    display: inline-block;
    margin-top: 1.5rem;
    color: #0066cc;
    text-decoration: none;
    font-size: 0.95rem;
  }

  /* ===== SIDEBAR ===== */
  .sticky-sidebar {
    position: sticky;
    top: 80px;
  }

  .widget {
    background: #f8f9fa;
    border-radius: 10px;
    padding: 1.2rem;
    margin-top: 1.5rem;
    border: 1px solid #eee;
  }

  .widget h3 {
    font-size: 1rem;
    color: #1a1a2e;
    margin-bottom: 0.8rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #ddd;
  }

  .widget p {
    font-size: 0.9rem;
    color: #555;
    margin-bottom: 0.8rem;
    line-height: 1.6;
  }

  .widget-link {
    color: #0066cc;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .category-list {
    list-style: none;
    padding: 0;
  }

  .category-list li {
    padding: 0.3rem 0;
    border-bottom: 1px solid #eee;
  }

  .category-list a {
    color: #444;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .category-list a:hover {
    color: #0066cc;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .blog-wrapper {
      grid-template-columns: 1fr;
    }
    .sidebar {
      display: none;
    }
  }
</style>
